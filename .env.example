# DOOD — ตัวแปรสภาพแวดล้อม (คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง)
# ⚠️ .env จริงห้ามขึ้น git (ถูก .gitignore ไว้แล้ว) — ไฟล์ .example นี้ใส่ค่าปลอมได้

# ── ฝั่งลูกค้า (ใส่ใน bundle ได้ ปลอดภัยเพราะมี RLS) ── ต้องมี prefix VITE_
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-or-publishable-key-here

# ── ฝั่งเซิร์ฟเวอร์/แอดมิน เท่านั้น (ลับสุด) ── ⛔ ห้ามมี prefix VITE_ เด็ดขาด
# (ถ้าเผลอตั้ง VITE_ นำหน้า = key ลับจะหลุดขึ้นเว็ปสาธารณะทันที)
SUPABASE_SERVICE_KEY=paste-service_role-or-secret-key-here
